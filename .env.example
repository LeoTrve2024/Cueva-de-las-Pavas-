# Desarrollo local. Cambiar credenciales antes de publicar.
POSTGRES_DB=pavas
POSTGRES_USER=pavas_admin
POSTGRES_PASSWORD=pavas_local_only

CLIMA_ENVIRONMENT=development
CLIMA_LOG_LEVEL=INFO
# Coordenadas WGS84 verificadas del balneario. No usar las del centro de Tingo María.
CLIMA_LATITUDE=-9.37105
CLIMA_LONGITUDE=-75.975

AFLUENCIA_ENVIRONMENT=development
AFLUENCIA_LOG_LEVEL=INFO
AFLUENCIA_RULES_VERSION=1
AFLUENCIA_ADMIN_USER=admin
AFLUENCIA_ADMIN_PASSWORD=admin
